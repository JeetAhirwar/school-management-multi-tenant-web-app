# =============================================================================
# School ERP Backend — environment template (copy to `.env` and fill in).
# .env is gitignored; ONLY this template is committed. Never put real secrets
# or real MongoDB URIs here.
# =============================================================================

# --- Authentication ----------------------------------------------------------
# Shared secret across ALL services - must be identical everywhere.
# MUST be at least 32 characters. Read ONLY from the environment; no fallback,
# and every service refuses to start without a valid value. Leave BLANK here:
# a copied, non-random placeholder secret is a known-secret session-forgery
# vector (docker/CI frequently copy this template verbatim).
JWT_SECRET=
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS --------------------------------------------------------------------
# Allowed CORS origins (comma separated) for browser clients. REQUIRED.
# If CORS_ORIGIN is unset, all services fail closed and reject browser
# cross-origin requests (recommended for production). Never leave it blank.
CORS_ORIGIN=http://localhost:5173

# --- MongoDB (one logical database per microservice) ------------------------
# Each service reads ONLY its own variable. Fill with either a local URI
# (mongodb://localhost:27017/erp_auth) or a MongoDB Atlas URI for development.
AUTH_MONGODB_URI=
STUDENT_MONGODB_URI=
STAFF_MONGODB_URI=
ACADEMIC_MONGODB_URI=
FEE_MONGODB_URI=
COMMUNICATION_MONGODB_URI=
LIBRARY_MONGODB_URI=
FACILITY_MONGODB_URI=
# Accounting reuses FEE_MONGODB_URI (database erp_accounting) when this is
# left blank — set it only to host accounting on its own cluster.
ACCOUNTING_MONGODB_URI=

# --- Database maintenance (run from the backend root) -------------------------
# node scripts/clean-db.js               -> delete ALL documents in the erp_*
#    application databases. Collections and indexes are preserved. There is no
#    undo — intended to reset a development database (dummy/test data only).
# node scripts/bootstrap-super-admin.js  -> idempotently create the single
#    platform super admin (administrator@aiknotsit.com). Override the default
#    bootstrap password with PLATFORM_SUPER_ADMIN_PASSWORD.

# --- Token validation --------------------------------------------------------
# When set to "off", downstream services skip local JWT validation against the
# shared User collection (development only). Any other value keeps it enabled.
# NOTE: In production (NODE_ENV=production) validation is ALWAYS enforced,
# even if this is set to "off" — the switch is ignored as a fail-safe.
TOKEN_VALIDATION=on

# --- Internal service-to-service notifications --------------------------------
# Shared key used by microservices to fan out inbox notifications to users by
# refId (e.g. homework submission -> student). Must match across all services.
# INTERNAL_NOTIFY_KEY=change-me-to-a-random-secret-at-least-32-characters

# --- ImageKit (image upload, used by 7 services) ----------------------------
# Required by auth/student/academic/fee/communication/library/facility services.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# --- Service ports -----------------------------------------------------------
GATEWAY_PORT=5000
AUTH_SERVICE_PORT=5001
STUDENT_SERVICE_PORT=5002
STAFF_SERVICE_PORT=5003
ACADEMIC_SERVICE_PORT=5004
FEE_SERVICE_PORT=5005
COMMUNICATION_SERVICE_PORT=5006
LIBRARY_SERVICE_PORT=5007
FACILITY_SERVICE_PORT=5008
ACCOUNTING_SERVICE_PORT=5009

# --- API Gateway -------------------------------------------------------------
# Internal service URLs (used by the gateway + inter-service calls)
PROXY_TIMEOUT_MS=10000
AUTH_SERVICE_URL=http://localhost:5001
STUDENT_SERVICE_URL=http://localhost:5002
STAFF_SERVICE_URL=http://localhost:5003
ACADEMIC_SERVICE_URL=http://localhost:5004
FEE_SERVICE_URL=http://localhost:5005
COMMUNICATION_SERVICE_URL=http://localhost:5006
LIBRARY_SERVICE_URL=http://localhost:5007
FACILITY_SERVICE_URL=http://localhost:5008
ACCOUNTING_SERVICE_URL=http://localhost:5009

# --- Email / SMTP (OTP password reset) ----------------------------------------
# Required for the "Forgot password" OTP flow and admin-sent reset OTPs.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=pr0mpt007.com@gmail.com
# SMTP_PASS=
# SMTP_FROM=School ERP <noreply@schoolerp.com>
# FRONTEND_URL=http://localhost:5173

# --- Bulk SMS (broadcast + notices) -------------------------------------------
# Broadcasts and priority alerts fan out over SMS only when enabled; otherwise
# they run in dry-run mode (logged, not delivered). "http" posts to a generic
# SMS gateway (SMS_API_URL/SMS_API_KEY/SMS_SENDER_ID); "twilio" uses Twilio.
# SMS_PROVIDER_ENABLED=false
# SMS_PROVIDER=http
# SMS_API_URL=https://example.com/api/sms/send
# SMS_API_KEY=
# SMS_SENDER_ID=ZIPSC
# SMS_TWILIO_SID=
# SMS_TWILIO_TOKEN=
# SMS_TWILIO_FROM=+15005550006

# --- Online fee payment (payment-order abstraction) --------------------------
# Provider integration is deployment work. Until PAYMENT_PROVIDER_ENABLED=true
# AND PAYMENT_PROVIDER_NAME is set, orders can be created but can never be
# confirmed as paid (confirm route returns 503). No fake payments are possible.
# PAYMENT_PROVIDER_ENABLED=false
# PAYMENT_PROVIDER_NAME=razorpay
# PAYMENT_PROVIDER_WEBHOOK_SECRET=
# PAYMENT_PROVIDER_CHECKOUT_BASE=
# PAYMENT_PROVIDER_KEY_ID=
# PAYMENT_PROVIDER_KEY_SECRET=

# --- Per-school payment gateway ----------------------------------------------
# Schools can bring their own collection method (Razorpay/Stripe/PhonePe keys,
# UPI ID, QR code, bank details, or manual/offline). Secrets are encrypted at
# rest with this key before being stored per school. Must be >= 16 characters;
# without it, gateway secrets cannot be saved (display-only modes still work).
# GATEWAY_KEYS_ENC_KEY=change-me-to-a-random-secret-at-least-16-characters